# ------------------------------
# Ability names & descriptions (2026-07-07, тексты Todd)
# ------------------------------

msgid "Ability_Poison_Coating"
msgstr "Poison Coating"

msgid "Ability_Poison_Coating_Description"
msgstr "For 3 turns every attack applies a poison stack. Each stack deals 75% of the damage dealt over 5 turns."

msgid "Ability_Poison_Explosion"
msgstr "Poison Explosion"

msgid "Ability_Poison_Explosion_Description"
msgstr "Consumes every poison stack on the target and deals their total damage at once. Executes the target at 42 or more stacks."

msgid "Ability_Critical_Calculation"
msgstr "Critical Calculation"

msgid "Ability_Critical_Calculation_Description"
msgstr "Increases critical chance by 45% for 3 turns. A critical strike extends the buff by 1 turn."

msgid "Ability_Dark_Shroud_Description"
msgstr "Increases Evade by 35% for 4 turns. Restores 5% health at the start of each turn."

msgid "Ability_Jar_Of_Poison"
msgstr "Jar of Poison"

msgid "Ability_Jar_Of_Poison_Description"
msgstr "Applies a poison stack dealing 50 + (35% + 50%) damage each turn for 3 turns."

msgid "Ability_Increasing_Pressure_Description"
msgstr "A series of up to {Attacks} escalating attacks. Each attack deals an additional {Damage} + ({WeaponDamageScale:%} + {SpellDamageScale:%}) base damage. Every successful hit empowers the next one by {AttackDamageStepMultiplier:%}."

msgid "Ability_Series_Of_Attacks"
msgstr "Series of Attacks"

msgid "Ability_Series_Of_Attacks_Description"
msgstr "A series of 2-5 attacks. Each attack deals an additional 30 + (50% + 25%) base damage. An evade interrupts the series."

msgid "Ability_Berserk_Fury_Description"
msgstr "Performs consecutive attacks: the chance to continue the series depends on current health — the lower it is, the lower the chance. Activation applies the {@Effect_Fury} effect."

msgid "Ability_Armageddon"
msgstr "Armageddon"

msgid "Ability_Armageddon_Description"
msgstr "Hold the activation to charge up to three stages. Stage one consumes 5% health and deals 300 + (75% + 75%) base damage. Stage two consumes 15% health and deals 600 + (120% + 120%). Stage three consumes 30% health, deals 1000 + (180% + 180%) and additionally stuns the target for 2 turns. Without enough health, the last reached stage is activated."

msgid "Ability_Double_Strike"
msgstr "Double Strike"

msgid "Ability_Double_Strike_Description"
msgstr "Delivers two consecutive strikes. The first deals 120 + (80% + 65%) base damage and reduces the target's armor on hit. The second deals 60 + (100% + 25%) base damage and reduces the target's evade on hit."

msgid "Ability_Head_Butt_Description"
msgstr "A single lunge dealing {Damage} + ({WeaponDamageScale:%} + {SpellDamageScale:%}) base damage, stunning the target for {StunDuration|turn|turns}."

msgid "Ability_Porcupine"
msgstr "Porcupine"

msgid "Ability_Porcupine_Description"
msgstr "For 3 turns returns 25% of the damage dealt + 15% of your armor back to the attacker."

msgid "Ability_Ares_Blessing"
msgstr "Ares' Blessing"

msgid "Ability_Ares_Blessing_Description"
msgstr "Increases health and health recovery by 30% for 3 turns."

msgid "Ability_Sacrifice_Description"
msgstr "Sacrifices 15% of current health. For every point of health lost, the next activated ability gains 1% as pure damage."

msgid "Ability_Ice_Shards"
msgstr "Ice Shards"

msgid "Ability_Ice_Shards_Description"
msgstr "Fires three ice shards. Each shard deals 80 + (25% + 90%) damage to the target.\nActivation level 2: shard damage increases to 120 + (35% + 120%).\nActivation level 3: shards strike every target on the battlefield.\nActivation level 4: on a critical strike the shards shatter into shrapnel, dealing 50 + (15% + 55%) damage to all enemies."

msgid "Ability_Ice_Block"
msgstr "Ice Block"

msgid "Ability_Ice_Block_Description"
msgstr "Drops a massive block of ice on the target: 230 + (50% + 130%) damage and a 1-turn stun.\nActivation level 2: the stun lasts 1 more turn.\nActivation level 3: applies a stack of {@Effect_Withering_Curse}.\nActivation level 4: three additional blocks fall on the target, each dealing 50% of the original block's damage."

msgid "Ability_Overload"
msgstr "Overload"

msgid "Ability_Overload_Description"
msgstr "Burns 25% of the target's current mana. Deals 100 + (15% + 40%) damage + 1.5 damage per point of mana burned.\nActivation level 2: the multiplier becomes 2 per point of mana burned.\nActivation level 3: a critical strike refunds 15% of the mana burned.\nActivation level 4: the damage becomes pure."

msgid "Ability_Chain_Lightning"
msgstr "Chain Lightning"

msgid "Ability_Chain_Lightning_Description"
msgstr "Deals 140 + (25% + 120%) base damage to the target and jumps to a random enemy up to two times. Each jump loses 25% damage.\nActivation level 2: +1 jump.\nActivation level 3: damage loss per jump is reduced by 15%.\nActivation level 4: the final jump deals double damage."

msgid "Ability_Ice_Aegis"
msgstr "Ice Aegis"

msgid "Ability_Ice_Aegis_Description"
msgstr "Grants a barrier equal to 300 + 35 per point of Intelligence for 3 turns.\nActivation level 2: additional +15 scaling per point of Intelligence.\nActivation level 3: while the barrier holds, attackers gain a stack of {@Effect_Clumsiness}.\nActivation level 4: if the barrier is destroyed before it expires, freezes every enemy on the battlefield."

