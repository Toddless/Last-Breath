# ------------------------------
# Ability names & descriptions (2026-07-07, тексты Todd)
# ------------------------------

msgid "Ability_Berserk_Fury"
msgstr "Berserk Fury"

msgid "Ability_Dark_Shroud"
msgstr "Dark Shroud"

msgid "Ability_Fireball"
msgstr "Fireball"

msgid "Ability_Fireball_Description"
msgstr "Deal {Damage} damage to the Target."

msgid "Ability_Increasing_Pressure"
msgstr "Increasing Pressure"

msgid "Ability_Mana_Devour"
msgstr "Mana Devour"

msgid "Ability_Mana_Devour_Description"
msgstr "Consume {ConsumePercent}% from current mana.\n For each mana consumed give {SpellDamagePerMana}% increased Spell Damage."

msgid "Ability_Sacrifice"
msgstr "Sacrifice"

msgid "Ability_Head_Butt"
msgstr "Head Butt"

msgid "Ability_Poison_Coating"
msgstr "Poison Coating"

msgid "Ability_Poison_Coating_Description"
msgstr "For {CoatingDuration|turn|turns} every attack applies a poison stack. Each stack deals {PoisonMultiplier:%} of the damage dealt over {PoisonDuration|turn|turns}."

msgid "Ability_Poison_Explosion"
msgstr "Poison Explosion"

msgid "Ability_Poison_Explosion_Description"
msgstr "Consumes every poison stack on the target and deals their total damage at once. Executes the target at {ExecutionThreshold} or more stacks."

msgid "Ability_Critical_Calculation"
msgstr "Critical Calculation"

msgid "Ability_Critical_Calculation_Description"
msgstr "Grants {Stacks} stacks of increased critical chance for {Duration|turn|turns}. A critical strike extends the buff by 1 turn."

msgid "Ability_Dark_Shroud_Description"
msgstr "For {Duration|turn|turns} applies {Stacks} stacks of Light Step (+{LightStepValue:%} evade each). Restores {HealthRegen:%} health at the start of each turn."

msgid "Ability_Jar_Of_Poison"
msgstr "Jar of Poison"

msgid "Ability_Jar_Of_Poison_Description"
msgstr "Applies a poison stack dealing {Damage} + ({WeaponDamageScale:%} + {SpellDamageScale:%}) damage each turn for {PoisonDuration|turn|turns}."

msgid "Ability_Increasing_Pressure_Description"
msgstr "A series of up to {Attacks} escalating attacks. Each attack deals an additional {Damage} + ({WeaponDamageScale:%} + {SpellDamageScale:%}) base damage. Every successful hit empowers the next one by {AttackDamageStepMultiplier:%}."

msgid "Ability_Series_Of_Attacks"
msgstr "Series of Attacks"

msgid "Ability_Series_Of_Attacks_Description"
msgstr "A series of {MinAttacks}-{MaxAttacks} attacks. Each attack deals an additional {Damage} + ({WeaponDamageScale:%} + {SpellDamageScale:%}) base damage. An evade interrupts the series."

msgid "Ability_Berserk_Fury_Description"
msgstr "Applies {@Effect_Fury} ({FuryDuration|turn|turns}, each attack burns {FuryHealthPercent:%} of current health) and performs consecutive attacks — the chance to continue the series depends on current health: the lower it is, the lower the chance."

msgid "Ability_Armageddon"
msgstr "Armageddon"

msgid "Ability_Armageddon_Description"
msgstr "Hold the activation to charge up to three stages. Stage one consumes 5% health and deals 300 + (75% + 75%) base damage. Stage two consumes 15% health and deals 600 + (120% + 120%). Stage three consumes 30% health, deals 1000 + (180% + 180%) and additionally stuns the target for {StunDuration|turn|turns}. Without enough health, the last reached stage is activated."

msgid "Ability_Double_Strike"
msgstr "Double Strike"

msgid "Ability_Double_Strike_Description"
msgstr "Delivers two consecutive strikes. The first deals {Damage} + ({WeaponDamageScale:%} + {SpellDamageScale:%}) base damage and reduces the target's armor on hit. The second deals {SecondDamage} + ({SecondWeaponScale:%} + {SecondSpellScale:%}) base damage and reduces the target's evade on hit."

msgid "Ability_Head_Butt_Description"
msgstr "A single lunge dealing {Damage} + ({WeaponDamageScale:%} + {SpellDamageScale:%}) base damage, stunning the target for {StunDuration|turn|turns}."

msgid "Ability_Porcupine"
msgstr "Porcupine"

msgid "Ability_Porcupine_Description"
msgstr "For {Duration|turn|turns} returns {DamageReturn:%} of the damage dealt + {ArmorReturn:%} of your armor back to the attacker."

msgid "Ability_Ares_Blessing"
msgstr "Ares' Blessing"

msgid "Ability_Ares_Blessing_Description"
msgstr "Increases maximum health by {HealthBonus:%} and health recovery by {RecoveryBonus:%} for {Duration|turn|turns}."

msgid "Ability_Sacrifice_Description"
msgstr "Sacrifices {SacrificePercent:%} of current health. For every 100 health lost, the next activated ability gains {RatePerHundred:%} as pure damage. Charges: {Charges}."

msgid "Ability_Ice_Shards"
msgstr "Ice Shards"

msgid "Ability_Ice_Shards_Description"
msgstr "Fires {Shards} ice shards. Each shard deals {Damage} + ({WeaponDamageScale:%} + {SpellDamageScale:%}) damage to the target.\nActivation level 2: shard damage increases to {SecondStageDamage} + ({SecondStageWeaponDamageScale:%} + {SecondStageSpellDamageScale:%}).\nActivation level 3: shards strike every target on the battlefield.\nActivation level 4: on a critical strike the shards shatter into shrapnel, dealing {ShrapnelDamage} + ({ShrapnelWeaponDamageScale:%} + {ShrapnelSpellDamageScale:%}) damage to all enemies."

msgid "Ability_Ice_Block"
msgstr "Ice Block"

msgid "Ability_Ice_Block_Description"
msgstr "Drops a massive block of ice on the target: {Damage} + ({WeaponDamageScale:%} + {SpellDamageScale:%}) damage and a {StunDuration|turn|turns} stun.\nActivation level 2: the stun lasts 1 more turn.\nActivation level 3: applies a stack of {@Effect_Withering_Curse}.\nActivation level 4: {ExtraBlocks} additional blocks fall on the target, each dealing {ExtraBlockDamagePercent:%} of the original block's damage."

msgid "Ability_Overload"
msgstr "Overload"

msgid "Ability_Overload_Description"
msgstr "Burns {ManaBurnPercent:%} of the target's current mana. Deals {Damage} + ({WeaponDamageScale:%} + {SpellDamageScale:%}) damage + {DamagePerMana} damage per point of mana burned.\nActivation level 2: the multiplier becomes 2 per point of mana burned.\nActivation level 3: a critical strike refunds 15% of the mana burned.\nActivation level 4: the damage becomes pure."

msgid "Ability_Chain_Lightning"
msgstr "Chain Lightning"

msgid "Ability_Chain_Lightning_Description"
msgstr "Deals {Damage} + ({WeaponDamageScale:%} + {SpellDamageScale:%}) base damage to the target and jumps to a random enemy up to {Jumps} times. Each jump loses {DamageFalloff:%} damage.\nActivation level 2: +1 jump.\nActivation level 3: damage loss per jump is reduced by 15%.\nActivation level 4: the final jump deals double damage."

msgid "Ability_Ice_Aegis"
msgstr "Ice Aegis"

msgid "Ability_Ice_Aegis_Description"
msgstr "Grants a barrier equal to {BarrierBase} + {PerIntelligenceScale} per point of Intelligence for {Duration|turn|turns}.\nActivation level 2: additional +15 scaling per point of Intelligence.\nActivation level 3: while the barrier holds, attackers gain a stack of {@Effect_Clumsiness}.\nActivation level 4: if the barrier is destroyed before it expires, freezes every enemy on the battlefield."

